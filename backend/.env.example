# 智谱 API
ZHIPU_API_KEY=your_api_key_here

# ChromaDB 存储路径
CHROMA_PERSIST_DIR=./data/chroma

# SQLite 数据库路径
SQLITE_DB_PATH=./data/interview.db

# 原始数据目录
RAW_DATA_DIR=./data/raw

# 处理后数据目录
PROCESSED_DATA_DIR=./data/processed

# 管理员认证
# 管理员登录密码（必填！生产环境必须设置一个强密码，无默认值，为空会拒绝所有登录请求）
ADMIN_PASSWORD=
# JWT 签名密钥。空值时由 app 启动时自动 os.urandom(32).hex() 生成一次性密钥
# （服务重启后旧 token 全部失效，管理员需重新登录）
JWT_SECRET_KEY=
# JWT 签名算法（默认 HS256）
JWT_ALGORITHM=HS256
# JWT 过期时间（分钟，默认 1440 = 24 小时）
JWT_EXPIRE_MINUTES=1440

# =============================================================================
# LLM / Embedding Provider 选择（v0.2.0+）
# =============================================================================
# 选择 LLM 后端："zhipu"（默认）或 "openai"（OpenAI 兼容端点）
# LLM_PROVIDER=zhipu
# 选择 Embedding 后端："zhipu"（默认）或 "openai"
# EMBEDDING_PROVIDER=zhipu

# --- 当 LLM_PROVIDER=openai 或 EMBEDDING_PROVIDER=openai 时 ---
# OpenAI API Key（必填）
# OPENAI_API_KEY=sk-xxx
# OpenAI 兼容端点 URL（空 = OpenAI 官方，也支持 Ollama / Azure 兼容端点）
# OPENAI_BASE_URL=
# 覆盖 LLM 模型名（空 = fallback 到 LLM_MODEL）
# OPENAI_LLM_MODEL=
# 覆盖 Embedding 模型名（空 = fallback 到 EMBEDDING_MODEL）
# OPENAI_EMBEDDING_MODEL=
