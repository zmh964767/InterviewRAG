# 智谱 API
ZHIPU_API_KEY=your_api_key_here

# ChromaDB 存储路径
CHROMA_PERSIST_DIR=./data/chroma

# SQLite 数据库路径
SQLITE_DB_PATH=./data/interview.db

# 原始数据目录
RAW_DATA_DIR=./data/raw

# 处理后数据目录
PROCESSED_DATA_DIR=./data/processed

# 管理员认证
# 管理员登录密码（生产环境务必修改，默认 admin123 会在启动时打印安全警告）
ADMIN_PASSWORD=admin123
# JWT 签名密钥。空值时由 app 启动时自动 os.urandom(32).hex() 生成一次性密钥
# （服务重启后旧 token 全部失效，管理员需重新登录）
JWT_SECRET_KEY=
# JWT 签名算法（默认 HS256）
JWT_ALGORITHM=HS256
# JWT 过期时间（分钟，默认 1440 = 24 小时）
JWT_EXPIRE_MINUTES=1440
